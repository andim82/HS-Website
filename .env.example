# Vorlage -- als .env kopieren und ausfuellen. .env ist gitignored.

# WordPress REST API (scripts/wp.mjs)
WP_BASE_URL=https://heimspiel.de
WP_USER=
# Application Password aus https://heimspiel.de/wp-admin/profile.php
# (Abschnitt "Anwendungspasswoerter"). NICHT das normale Login-Passwort.
WP_APP_PASSWORD=

# Prerender-Workflow (scripts/push-snapshots.mjs, sonst GitHub Actions Secret)
HS_SNAPSHOT_API_KEY=
